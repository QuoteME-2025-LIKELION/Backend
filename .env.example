# Docker Hub
DOCKERHUB_USERNAME=your_dockerhub_username

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# ── DB (Amazon RDS 또는 EC2 내 MySQL) ──────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=quoteme
DB_USERNAME=quoteme_user
DB_PASSWORD=strong_password_here

# ── 앱 시크릿 ──────────────────────────────────────────────
SECRET_KEY=random_secret_key
JWT_SECRET_KEY=minimum_32_chars_random_string_here

# ── Google Gemini ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── OAuth2 ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# OAuth2 리디렉트 기본 URL (ngrok 또는 localhost 사용)
CUSTOM_OAUTH2_REDIRECT_BASE=https://your-ngrok-subdomain.ngrok-free.app
# 프론트엔드 허용 Origin 목록 (쉼표 구분). 로컬 포트와 배포 도메인을 함께 설정
CUSTOM_FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://www.your-frontend-domain.com

# ── AWS S3 (EC2 IAM Role 사용 시 ACCESS/SECRET_KEY 삭제 가능) ──
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET=quoteme-test-2026

# ── 도메인 ─────────────────────────────────────────────────
FRONT_URL=https://quoteme.shop
BACK_URL=https://api.quoteme.shop
COOKIE_DOMAIN=quoteme.shop

# ── 노션 공지 동기화 (비우면 동기화 꺼짐) ─────────────────────
# 노션 통합(Integration) 내부 토큰. 공지 DB를 이 통합에 공유해야 조회된다
NOTION_TOKEN=
# 공지 데이터베이스 ID (DB URL의 32자리 ID)
NOTION_NOTICE_DATABASE_ID=
# true면 10분마다 노션 공지를 notice 테이블로 동기화
NOTION_SYNC_ENABLED=false

# ── FCM 푸시 알림 (비우면 푸시만 꺼지고 인앱 알림은 그대로) ─────
# Firebase 서비스 계정 키 JSON 파일을 base64 한 줄로 인코딩한 값 (base64 -w0 key.json)
FIREBASE_CREDENTIALS_BASE64=